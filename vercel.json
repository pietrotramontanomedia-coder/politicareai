{
  "framework": "nextjs",
  "redirects": [
    { "source": "/", "destination": "https://app.politicare.it/", "permanent": true },
    { "source": "/redazione/:percorso*", "destination": "https://redazione.politicare.it/redazione/:percorso*", "permanent": true },
    { "source": "/:percorso((?!api/ultimora$).*)", "destination": "https://app.politicare.it/:percorso", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/ultimora", "destination": "https://app.politicare.it/api/ultimora" }
  ]
}
