# Copia in .env.local e adatta. Nessuna di queste variabili è obbligatoria.

# Ultim'ora agenzie (lib/agenzie/server.ts)
# "1" = usa sempre i feed finti in content/agenzia/finto (utile offline)
# "0" = usa sempre i feed reali
# assente = finti in `next dev`, reali in produzione
AGENZIE_SIMULA=

# Feed RSS reali: sovrascrivono gli indirizzi predefiniti in lib/agenzie/tipi.ts
AGENZIE_FEED_ANSA=
AGENZIE_FEED_ADNKRONOS=

# Ultim'ora redazionale (Instagram)
INSTAGRAM_ACCESS_TOKEN=
