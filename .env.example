# Copiare in .env.local (che resta fuori da git) e riempire.

# Profilo con account: progetto Supabase in regione UE.
# Senza queste due variabili l'app funziona lo stesso, con il profilo sul dispositivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ultim'ora e post da Instagram (solo produzione: vedi lib/instagram-server.ts).
# INSTAGRAM_ACCESS_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# Chiave del job settimanale che rinnova il token Instagram.
# CRON_SECRET=

# Ponte Telegram → X (vedi docs/TELEGRAM-X.md). Solo produzione, su Vercel.
# TELEGRAM_BOT_TOKEN=          token del bot creato con @BotFather, amministratore del canale
# TELEGRAM_WEBHOOK_SECRET=     stringa casuale lunga: la stessa su Vercel e in .env.local per registrare il webhook
# TELEGRAM_CANALE=politicare   nome del canale seguito (senza @)
# X_API_KEY=                   dal portale sviluppatori di X, app con permessi Read and Write
# X_API_SECRET=
# X_ACCESS_TOKEN=              token dell'account @politicare generato dalla stessa app
# X_ACCESS_SECRET=
# X_LINK_NOTIZIE=mai           mai | se-troncato | sempre: quando aggiungere il link alla notizia sul sito (un post con link costa di più su X)
# X_TITOLO=normale             normale | maiuscolo | nessuno: la prima frase del post diventa il titolo su una riga a sé
# X_FIRMA=                     riga di chiusura del post (predefinita: nessuna)
# X_HASHTAG=3                  quante parole rilevanti del testo diventano hashtag (0 per nessuna)
# X_LIMITE=280                 caratteri massimi; con X Premium sull'account si può alzare fino a 25000
# ANTHROPIC_API_KEY=           chiave Claude (console.anthropic.com): un post troppo lungo viene riscritto più corto invece di tagliato
# X_RISCRITTURA=1              0 per spegnere la riscrittura e accorciare solo per frasi intere
# SITO_URL=https://politicare-app.vercel.app

# Radar dei trend su X (vedi docs/RADAR.md). Scollegato dal ponte: bot, app X e chiave Claude suoi.
# RADAR_MODALITA=avvisa        vuota = spento | registra (bozze senza avvisi) | avvisa (messaggi su Telegram)
# RADAR_TELEGRAM_BOT_TOKEN=    token di un bot creato apposta con @BotFather (non quello del ponte)
# RADAR_TELEGRAM_CHAT=         id Telegram di chi riceve gli avvisi (lo dà @userinfobot)
# RADAR_X_BEARER_TOKEN=        Bearer Token di un'app X creata apposta, solo lettura
# RADAR_ANTHROPIC_API_KEY=     chiave Claude creata apposta per il radar
# RADAR_MASSIMO_GIORNO=3       tetto di temi valutati al giorno: il freno sulla spesa
# RADAR_ORARIO=10-22           ore italiane in cui il radar lavora, ultimo giro alle 21 (0-24 = tutto il giorno)
# RADAR_INTERVALLO_MINUTI=55   minuti minimi fra due giri: un giro all'ora
# RADAR_CAMPIONE=10            post letti su X per capire il tema (0 = nessuno, costa la metà)
# RADAR_VALUTAZIONI=1          temi valutati da Claude a ogni giro
# RADAR_ACCELERAZIONE=1.5      accelerazione minima dell'ultima ora rispetto alle tre precedenti
# RADAR_RIPOSO_ORE=12          ore prima di riproporre lo stesso tema
