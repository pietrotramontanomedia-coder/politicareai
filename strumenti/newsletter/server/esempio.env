# Modello delle variabili. installa.sh crea da solo il file .env con password casuali:
# questo file serve solo come riferimento. Il vero .env resta sul server e non va mai in git.

# Indirizzo del pannello e dei link nelle mail (serve un record DNS A che punti al server).
DOMINIO=newsletter.politicare.it

# Password del database: lunga e casuale, nessuno deve ricordarla.
DB_PASSWORD=

# Primo amministratore del pannello Listmonk (creato solo al primo avvio).
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
