{
  "name": "politicare",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run && npm run test --workspace=@politicare/motore",
    "test:watch": "npm run test:watch --workspace=@politicare/motore",
    "test:app": "vitest run",
    "test:motore": "npm run test --workspace=@politicare/motore",
    "telegram-x": "node --no-warnings strumenti/telegram-x.mjs",
    "radar": "node --no-warnings strumenti/radar.mjs",
    "build:app": "node scripts/build-app.mjs",
    "app:android": "cap open android",
    "app:ios": "cap open ios",
    "app:icone": "npx -y @capacitor/assets@3 generate --ios --android --iconBackgroundColor '#0a0a0a' --iconBackgroundColorDark '#0a0a0a' --splashBackgroundColor '#0a0a0a' --splashBackgroundColorDark '#0a0a0a'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@politicare/motore": "*",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/blob": "^2.8.0",
    "cheerio": "^1.2.0",
    "framer-motion": "^12.0.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "twitter-api-v2": "^1.29.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
