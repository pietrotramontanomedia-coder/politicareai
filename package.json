    "cheerio": "^1.2.0",
    "framer-motion": "^12.0.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "twitter-api-v2": "^1.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
