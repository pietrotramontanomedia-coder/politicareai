    {
      "id": "fisco-001",
      "testo": "Il governo dovrebbe introdurre una flat tax al 15-20% per imprese, lavoratori autonomi e cittadini",
      "area": "fisco",
      "verso": 1
    },
    {
      "id": "ambiente-001",
      "testo": "L'Italia dovrebbe mantenere il divieto del nucleare e investire solo in energie rinnovabili",
      "area": "ambiente",
      "verso": -1
    },
    {
      "id": "immigrazione-001",
      "testo": "I confini dell'Unione Europea dovrebbero essere rigidamente controllati con procedure automatiche di respingimento",
      "area": "immigrazione",
      "verso": 1
    },
    {
      "id": "lavoro-001",
      "testo": "Dovrebbe esserci un salario minimo nazionale garantito di almeno 10 euro all'ora",
      "area": "lavoro",
      "verso": 1
    },
    {
      "id": "sanita-001",
      "testo": "La sanità pubblica dovrebbe essere l'unico livello disponibile, eliminando gradualmente la sanità privata",
      "area": "sanita",
      "verso": 1
    },
    {
      "id": "europa-001",
      "testo": "L'Italia dovrebbe mantenere un ruolo centrale e protagonista nell'Unione Europea",
      "area": "europa",
      "verso": -1
    },
    {
      "id": "ambiente-002",
      "testo": "Gli investimenti pubblici dovrebbero privilegiare il trasporto su ferro e la mobilità sostenibile rispetto alle strade",
      "area": "ambiente",
      "verso": -1
    },
    {
      "id": "lavoro-002",
      "testo": "La scuola privata dovrebbe ricevere lo stesso finanziamento pubblico per alunno della scuola pubblica",
      "area": "lavoro",
      "verso": 1
    },
    {
      "id": "diritti-001",
      "testo": "Il matrimonio tra persone dello stesso sesso dovrebbe avere gli stessi diritti civili e patrimoniali del matrimonio tradizionale",
      "area": "lavoro",
      "verso": 1
    },
    {
      "id": "fisco-002",
      "testo": "I sindacati dovrebbero avere più potere nella contrattazione dei salari e delle condizioni di lavoro",
      "area": "fisco",
      "verso": 1
    },
    {
      "id": "istituzionale-001",
      "testo": "Il Presidente della Repubblica dovrebbe essere eletto direttamente dai cittadini e non dal Parlamento",
      "area": "europa",
      "verso": -1
    },
    {
      "id": "immigrazione-002",
