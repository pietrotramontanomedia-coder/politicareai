# Copia in .env.app. Indirizzo pubblico del sito Politicare in produzione:
# l'app ci chiede feed, ultim'ora e articoli, e lo usa nei link che condivide.
# Test, quiz, gioco, simulatore e metodologia sono già nel pacchetto e funzionano offline.
NEXT_PUBLIC_SITO_URL=https://politicare-app.vercel.app

# Profilo con account (facoltativo): le stesse chiavi pubbliche del sito.
# Senza, l'app tiene il profilo sul dispositivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
